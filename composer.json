{
    "name": "jonpurvis/monzo-php",
    "description": "Framework-agnostic Monzo Developer API SDK built with Saloon",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jon Purvis",
            "homepage": "https://jonathanpurvis.co.uk"
        }
    ],
    "keywords": [
        "monzo",
        "saloon",
        "api",
        "sdk",
        "oauth"
    ],
    "require": {
        "php": "^8.2",
        "saloonphp/saloon": "^4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "JonPurvis\\Monzo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JonPurvis\\Monzo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "php-cs-fixer fix --allow-risky=yes",
            "rector"
        ],
        "refactor": "rector",
        "test:lint": [
            "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
            "rector --dry-run"
        ],
        "test:refactor": "rector --dry-run",
        "test:types": "phpstan analyse --memory-limit=512M",
        "test:unit": "phpunit",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    }
}
