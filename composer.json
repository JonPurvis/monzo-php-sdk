{
    "name": "jonpurvis/monzo-php",
    "description": "Framework-agnostic Monzo Developer API SDK built with Saloon",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "JonPurvis"
        }
    ],
    "require": {
        "php": "^8.2",
        "saloonphp/saloon": "^4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "JonPurvis\\Monzo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JonPurvis\\Monzo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
